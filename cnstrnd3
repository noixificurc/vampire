#!/bin/bash

#########################################
## slurm
#########################################
#SBATCH --job-name=mn3sn
#SBATCH --output=./proc.log
#SBATCH --partition=all  
##SBATCH --nodelist=r3 
#SBATCH --exclude=r1
#SBATCH --ntasks=1       
#SBATCH --cpus-per-task=1
#SBATCH --gres=gpu:0
#SBATCH --array=0-359:1  ## start and end indices are included

ARRAY=()
ARRAY1=()
ARRAY2=()
for x in {90..90}; do
  for y in {000..359}; do
    ARRAY+=("$x-$y")
    ARRAY1+=($x)
    ARRAY2+=($y)
  done
done


#########################################
## configuration
#########################################
SIZEX=2.5
SIZEY=2.0
SIZEZ=3.0
STEP=10000000
INCR=$(echo "${STEP} / 5000" | bc)
SEED=$SLURM_ARRAY_TASK_ID
TEMP=0.0
THETA=${ARRAY1[$SLURM_ARRAY_TASK_ID]}
PHI=${ARRAY2[$SLURM_ARRAY_TASK_ID]}
ISO1=$(awk 'BEGIN{print 1.602176634 * 10^-22 * 2 * -23}')
DMI1=$(awk 'BEGIN{print 1.602176634 * 10^-22 * 2 * 1.6}')
ISO2=$(awk -v x="$ISO1" 'BEGIN{print -1 * x}')
ISO3=$(awk -v x="$ISO1" 'BEGIN{print  0 * x}')
DMI3=$(awk -v x="$DMI1" 'BEGIN{print  0 * x}')
AISO=$(awk 'BEGIN{print 1.602176634 * 10^-22 * 0.17}')
DAMP=1.0
## Gamma 5x
##ISD1="-1,-1,0"
##ISD2="-1,+1,0"
##ISD3=" 1, 0,0"
## Gamma 3x
##ISD1="-1,+1,0"
##ISD2="-1,-1,0"
##ISD3=" 1, 0,0"
## coordinate axes
##ISD1="1,0,0"
##ISD2="0,1,0"
##ISD3="0,0,1"
## different
##ISD1="0.8165,−0.4082,−0.4082"
##ISD2="−0.4082,−0.4082,0.8165"
##ISD3="−0.4082,0.8165,−0.4082"
## random
##ISD1="random"
##ISD2="random"
##ISD3="random"
## edit
rot3d() {
  awk -F, -v p="$PHI" -v t="$THETA" 'BEGIN{pi=atan2(0,-1)}
  { x=$1+0; y=$2+0
    az = atan2(y,x) + p*pi/180      # original in-plane direction + phi
    th = t*pi/180
    printf "%.6f,%.6f,%.6f\n", sin(th)*cos(az), sin(th)*sin(az), cos(th) }' <<< "$1"
}
ISD1=$(rot3d "-1,-1,0")
ISD2=$(rot3d "-1,+1,0")
ISD3=$(rot3d " 1, 0,0")

# 1st shell
DMI1N=$(awk -v x="$DMI1"  'BEGIN{print -1 * x}')
DMI1T=$(awk -v x="$DMI1N" 'BEGIN{print -1 * x}')
# 3rd shell
DMI3N=$(awk -v x="$DMI3"  'BEGIN{print -1 * x}')
DMI3T=$(awk -v x="$DMI3N" 'BEGIN{print -1 * x}')



########################################
## paths
########################################
SRC="$(pwd)/"
DATE="$(date +'%y%m%d-%H%M%S')-$(date +%N | cut -c1-6)"  ## date
OUT="${SRC}../../data/${SLURM_ARRAY_JOB_ID}/${DATE}-${ARRAY[$SLURM_ARRAY_TASK_ID]}/"  ## path output directory
CNFSRC="${SRC}conf/sub3/constrained/"  # source of configuration files
CNFOUT="${OUT}conf/"  # destination of configuration files
VAMP="vampire-serial"  # Vampire file base name
EXCSRC="${SRC}${VAMP}"  ## Vampire executable in source directory
EXCOUT="${OUT}${VAMP}"  ## Vampire executable in source directory
VDC="${SRC}util/vdc/vdc"  ## Vampire to povray converter
META="${OUT}meta/"  ## meta data 
LOG="${OUT}proc.log"  ## logfile with std output


########################################
## prepare input and output
########################################
mkdir -p "$META" "$CNFOUT"
cp $EXCSRC ${BASH_SOURCE[0]} $OUT
cp $EXCSRC $EXCOUT
prepCnf $CNFSRC        \
        $CNFOUT        \
        "SIZEX=$SIZEX" \
        "SIZEY=$SIZEY" \
        "SIZEZ=$SIZEZ" \
        "STEP=$STEP"   \
        "INCR=$INCR"   \
        "SEED=$SEED"   \
        "TEMP=$TEMP"   \
        "THETA=$THETA" \
        "PHI=$PHI"     \
        "ISO1=$ISO1"   \
        "DMI1N=$DMI1N" \
        "DMI1T=$DMI1T" \
        "ISO2=$ISO2"   \
        "ISO3=$ISO3"   \
        "DMI3N=$DMI3N" \
        "DMI3T=$DMI3T" \
        "AISO=$AISO"   \
        "DAMP=$DAMP"   \
        "ISD1=$ISD1"   \
        "ISD2=$ISD2"   \
        "ISD3=$ISD3"


########################################
## run
########################################
cd $OUT
## run simulation
$EXCOUT --input-file "${CNFOUT}input" \
        --output-file "result"
## create povray file
$VDC --povray                    \
     --input-file "atoms-coords" \
     --vector-z 0,0,1            \
     --slice 0,1,0,1,0,1         \
     --camera-position 0,0.001,1
## render spin configuration
NFRAME=$(find ${OUT} -name 'spins-*.inc' -printf '%f\n' |
         sed 's/spins-\([0-9]*\)\.inc/\1/' |
         sort -n |
         tail -1)  ## number of frames
povray -W2000              \
       -H1500              \
       -D                  \
       +KFI0               \
       +KFF${NFRAME}       \
       +O${META}/conf-.png \
       ${OUT}spins.pov


########################################
## clean
########################################
rm $EXCOUT
