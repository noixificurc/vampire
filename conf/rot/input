#------------------------------------------
# Mn3Sn input file
#------------------------------------------

#------------------------------------------
# Creation attributes:
#------------------------------------------
dimensions:system-size-x = <SIZEX> !nm
dimensions:system-size-y = <SIZEY> !nm
dimensions:system-size-z = <SIZEZ> !nm

material:unit-cell-file = ./conf/mn3sn.ucf

create:periodic-boundaries = xy
create:spin-initialisation-random-seed = <SEED>

#------------------------------------------
# Material Files:
#------------------------------------------
material:file = ./conf/mn3sn.mat

#------------------------------------------
# Simulation attributes:
#------------------------------------------
sim:temperature = <TEMP>
sim:time-steps-increment = <INCR>
sim:total-time-steps = <STEP>
sim:time-step = 1 !fs
sim:constraint-angle-theta = <THETA>
sim:constraint-angle-phi   = <PHI>

#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:program = time-series
sim:integrator = hybrid-constrained-monte-carlo
#montecarlo:algorithm = uniform

#------------------------------------------
# data output
#------------------------------------------
output:precision=15

output:real-time
output:electron-temperature
output:phonon-temperature
output:material-magnetisation
output:magnetisation
output:total-energy
output:constraint-theta
output:constraint-phi

#screen:time-steps

config:atoms
