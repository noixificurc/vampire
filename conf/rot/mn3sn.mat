#===================================================
# Mn3Sn material file
#===================================================

#---------------------------------------------------
# Number of Materials
#---------------------------------------------------
material:num-materials=3

#---------------------------------------------------
# Material 1 Mn
#---------------------------------------------------
material[1]:material-name=Mn
material[1]:material-element = C
material[1]:unit-cell-category = 1
material[1]:damping-constant = <DAMP>
material[1]:atomic-spin-moment = 3.0 !muB
material[1]:second-order-uniaxial-anisotropy-constant = <AISO>
material[1]:uniaxial-anisotropy-direction = -0.5,0.8660254,0
material[1]:minimum-height = 0.0
material[1]:maximum-height = 1.0
material[1]:initial-spin-direction = <ISD1>
#material[1]:constrained = false
#material[1]:constraint-angle-theta = <PHI>
#material[1]:constraint-angle-phi = <THETA>
#---------------------------------------------------
# Material 2 Mn
#---------------------------------------------------
material[2]:material-name=Mn
