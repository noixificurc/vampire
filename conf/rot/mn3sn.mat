#---------------------------------------------------
# Material 3 Mn
#---------------------------------------------------
material[3]:material-name=Mn
material[3]:material-element = N
material[3]:unit-cell-category = 3
material[3]:damping-constant = <DAMP>
material[3]:atomic-spin-moment = 3.0 !muB
material[3]:second-order-uniaxial-anisotropy-constant = <AISO>
material[3]:uniaxial-anisotropy-direction = 1,0,0
material[3]:minimum-height = 0.0 
material[3]:maximum-height = 1.0
material[3]:initial-spin-direction = <ISD3>
material[3]:constrained = true
material[3]:constraint-angle-theta = <PHI>
material[3]:constraint-angle-phi = <THETA>
