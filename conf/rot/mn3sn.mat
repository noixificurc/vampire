material[2]:atomic-spin-moment = 3.0 !muB
material[2]:second-order-uniaxial-anisotropy-constant = <AISO>
material[2]:uniaxial-anisotropy-direction = -0.5,-0.8660254,0
material[2]:minimum-height = 0.0
material[2]:maximum-height = 1.0
